# Overnight Precipitation Alerter — sample config
#
# Copy to .env and fill in real values. Never commit .env.
#   cp .env.example .env

# --- Location -----------------------------------------------------------------
# Latitude / longitude to forecast for.
# NWS api.weather.gov rejects more than 4 decimal places.
PRECIP_LAT=40.7128
PRECIP_LON=-74.0060

# --- Notifications -----------------------------------------------------------
# ntfy topic to publish alerts to. Public topics are unauthenticated: anyone who
# guesses the topic can read AND publish. Make this long and random, keep it out
# of source control.
PRECIP_NTFY_TOPIC=precip-alert-CHANGE-ME-to-something-long-and-random-9f3a2c7b1e

# --- NWS API ---------------------------------------------------------------
# api.weather.gov requires a User-Agent with contact info or it rejects the
# request. Format: "app-name (contact-email-or-url)".
PRECIP_USER_AGENT=overnight-precip-alerter (you@example.com)

# --- Overnight window ------------------------------------------------------
# Local window to inspect: 8:00 PM -> 7:00 AM the next morning. Interpreted in the
# location's own time zone, as reported by NWS (not configured here). Must cross
# midnight.
PRECIP_WINDOW_START=20:00
PRECIP_WINDOW_END=07:00

# --- Alert threshold ----------------------------------------------------------
# Block 1: fire if any hour in the window has probabilityOfPrecipitation >= this.
PRECIP_PROBABILITY_THRESHOLD=50
