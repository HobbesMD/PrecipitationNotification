# Overnight Precipitation Alerter — sample config
#
# Copy to .env and fill in real values. Never commit .env.
#   cp .env.example .env
#
# Locations, coordinates, the overnight window and the alert threshold live in
# the database now (POST /locations, PUT /locations/{id}/rule), not here.

# --- Database -----------------------------------------------------------------
# Postgres connection string. This sample points at `docker compose up -d`
# (docker-compose.yml); its password is dev-only. Production (Neon) is never
# written here: see deploy/azure/README.md.
ConnectionStrings__Precip=Host=localhost;Port=5432;Database=precip;Username=postgres;Password=dev-only-password

# --- Notifications -----------------------------------------------------------
# ntfy topic to publish alerts to. Public topics are unauthenticated: anyone who
# guesses the topic can read AND publish. Make this long and random, keep it out
# of source control.
PRECIP_NTFY_TOPIC=precip-alert-CHANGE-ME-to-something-long-and-random-9f3a2c7b1e

# --- NWS API ---------------------------------------------------------------
# api.weather.gov requires a User-Agent with contact info or it rejects the
# request. Format: "app-name (contact-email-or-url)".
PRECIP_USER_AGENT=overnight-precip-alerter (you@example.com)

# --- Admin API ---------------------------------------------------------------
# Shared secret for the local-only admin API (src/Api), sent as the X-Api-Key
# header. >=32 chars; `openssl rand -hex 32`.
PRECIP_API_KEY=CHANGE-ME-openssl-rand-hex-32

# --- Worker ------------------------------------------------------------------
# Long-running mode only (no --once): time between passes. The deployed job runs
# `Worker --once` and ignores this.
Worker__Interval=01:00:00
